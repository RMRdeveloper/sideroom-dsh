{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "coverageAnalysis": "perTest",
  "mutate": [
    "lib/index.js",
    "lib/src/**/*.js",
    "!lib/**/*.test.js"
  ],
  "ignorePatterns": [
    "docs/**",
    "locale/**",
    "reports/**",
    "coverage/**"
  ],
  "tap": {
    "testFiles": [
      "lib/**/*.test.js"
    ],
    "nodeArgs": [
      "--test-reporter=tap",
      "-r",
      "{{hookFile}}",
      "{{testFile}}"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 20000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 10,
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation.html"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "cleanTempDir": "always"
}
