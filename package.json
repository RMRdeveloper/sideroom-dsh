{
  "name": "@rmrdeveloper/sideroom-dsh",
  "version": "0.3.0",
  "description": "Quality layer for DeepSeek Harness: guidelines gate, mechanical rule checks, and an end-of-edit review prompt.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RMRdeveloper/sideroom-dsh.git"
  },
  "homepage": "https://github.com/RMRdeveloper/sideroom-dsh#readme",
  "bugs": {
    "url": "https://github.com/RMRdeveloper/sideroom-dsh/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "coding-agent",
    "guidelines",
    "code-quality",
    "guardrails",
    "rules",
    "review",
    "skills"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "!lib/**/*.test.js",
    "cordis.patch.yml",
    "assets/**",
    "locale/*.json",
    "icon.svg",
    "docs/**/*.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mutation": "npm run build && stryker run",
    "mutation:dry": "npm run build && stryker run --dryRunOnly",
    "test": "npm run build && node --test \"lib/**/*.test.js\"",
    "check": "npm run types && npm run lint && npm test && npm run check:pack",
    "check:pack": "node scripts/check-pack.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "prepare": "husky",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --fix"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-no-comments": "^1.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "lint-staged": "^16.4.0",
    "semver": "^7.7.2",
    "tsc-alias": "^1.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
